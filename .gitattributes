# Finales de línea LF en el repo, siempre. Se desarrolla en Windows y se
# despliega en Linux; sin esto el mismo archivo tiene distinto contenido en cada
# lado. Importa además porque scripts/copiar-sw.mjs saca la versión del cache de
# un hash del service worker: con finales distintos, el hash cambia solo.
* text=auto eol=lf

# Binarios: que git no los toque.
*.png binary
*.ico binary
*.pem binary
