# ---------------------------------------------------------------------------
# DogWalkr API: variables de entorno
# Copiá este archivo a `.env` (no se commitea). En desarrollo, `npm run dev` lo
# carga solo si existe. En producción configurá las variables en el hosting.
# Si dejás una variable vacía (VAR=), se usa el valor por defecto.
# ---------------------------------------------------------------------------

# Entorno de ejecución: development | test | production. Por defecto: development.
# En producción poné `production` (en development los logs usan pino-pretty, que
# es una dependencia de desarrollo).
NODE_ENV=development

# Puerto HTTP donde escucha la API. Por defecto: 4000.
PORT=4000

# Orígenes permitidos por CORS, separados por coma (sin espacios ni barra final).
# Tiene que incluir la URL del cliente. Por defecto: http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Nivel de log de pino: fatal | error | warn | info | debug | trace | silent.
# Por defecto: info. En los tests siempre es silent.
LOG_LEVEL=info

# Si la API corre detrás de un proxy (hosting, balanceador), Express tiene que
# confiar en X-Forwarded-For para ver la IP real (lo va a necesitar el rate limit).
# Valores: false | true | cantidad de proxies (ej. 1). Preferí un número: `true`
# confía en cualquier IP que mande el cliente. Por defecto: false.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Fases siguientes (todavía no se usan; descomentá cuando llegue la fase)
# ---------------------------------------------------------------------------

# Fase 2: base de datos PostgreSQL con la extensión PostGIS (Sequelize).
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/dogwalkr

# Fase 4: autenticación con Supabase. La API valida los JWT que emite Supabase.
# SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Opción A: secreto compartido (proyectos con JWT firmados con HS256).
# SUPABASE_JWT_SECRET=
# Opción B (recomendada): claves asimétricas. No hace falta secreto: los JWT se
# verifican con el JWKS público en ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
