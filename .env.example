# Copiá este archivo a .env.local y completá los valores.
#
#   cp .env.example .env.local
#
# Los dos valores salen de Supabase → Project Settings → API.
# En Vercel van en Project Settings → Environment Variables.

# URL del proyecto. Algo como https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave "anon" / "publishable". Viaja al navegador y está bien que así sea: por
# sí sola no da permisos. Quién puede leer o escribir qué lo decide Row Level
# Security, no la clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NO agregues acá la clave service_role. Saltea RLS por completo y este proyecto
# no la usa en ningún lado.
